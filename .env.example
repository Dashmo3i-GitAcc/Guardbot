# ---- required ----
BOT_TOKEN=123456:ABC-your-token-from-botfather
GROUP_IDS=-1001234567890
# private admin group where reports are sent (optional but recommended)
ADMIN_LOG_CHAT=-1009876543210

# ---- optional ----
# extra user ids that are always immune (comma separated)
WHITELIST_USER_IDS=

# ---- instant media flood (burst) ----
# More than BURST_MAX_ITEMS qualifying media messages from the same user inside
# BURST_WINDOW_SECONDS is a flood. The window is deliberately very short: this
# stops an instant flood, it is not a "sent a lot of media today" rule.
BURST_ENABLED=true
BURST_WINDOW_SECONDS=3
BURST_MAX_ITEMS=5
# Which media kinds count. Ordinary photos are never counted, so sending
# several photos quickly is not a flood.
#   gif, sticker, animated_sticker, video_sticker, video_note
BURST_MEDIA_KINDS=gif,sticker,animated_sticker,video_sticker,video_note

# ---- repeated violations ----
# One confirmed explicit-media deletion = one violation. A warning is sent each
# time; the timed restriction is applied when the count reaches this number.
VIOLATION_MUTE_AFTER=3
# Restriction length in minutes (0 = no automatic expiry). Telegram lifts a
# timed restriction itself, so no reaper is needed.
# NOTE: this used to be MUTE_HOURS (default 24). A leftover MUTE_HOURS in an
# existing .env is no longer read.
MUTE_MINUTES=15

# ---- inbound text filters (links, banned words, phishing) ----
# The rules that do not need a model. Deterministic and cheap, applied before
# anything is sent to Gemini: a rule that can be a regex should not be a request
# against a shared quota.
#
# OFF by default. These rules delete somebody's message and a false positive
# cannot be undone, so enabling them is a decision to make after reading the
# review log, not a default.
FILTER_ENABLED=false

# What each family does when the filter is on: off | review | delete.
# "review" reports the hit to the admin log without touching the message.
FILTER_LINK_ACTION=review
FILTER_WORD_ACTION=delete
FILTER_PHISHING_ACTION=delete

# Comma-separated. Banned words are matched on word boundaries, so a short word
# cannot fire from inside a longer one ("ass" does not match "class"). Persian
# and English entries are both fine.
FILTER_BANNED_WORDS=

# Comma-separated domains that are always allowed, matched on the host and its
# subdomains. The escape hatch for a legitimate link.
FILTER_ALLOWED_DOMAINS=

# Administrators are exempt by default: a filter that mutes the moderation team
# is a filter that gets switched off.
FILTER_EXEMPT_ADMINS=true

# Messages shorter than this are not filtered at all.
FILTER_MIN_CHARS=4

# Whether a filter hit also counts as a violation (a strike, and eventually the
# timed restriction). Off by default: a deleted link and a deleted explicit
# image are not the same offence.
FILTER_COUNTS_AS_VIOLATION=false

# ---- test account ----
# One user id used to exercise the moderation pipeline repeatedly in a test
# group. It is NOT exempt from anything: detection, deletion, strikes, the admin
# report and the real Telegram restrict call all run normally. The only
# difference is that a successful restriction is lifted again after
# TEST_USER_UNRESTRICT_SECONDS, and the warning from that cycle is deleted, so
# the next test violation can be sent straight away. Set TEST_USER_ID=0 to
# disable the exception entirely.
TEST_USER_ID=8299811287
TEST_USER_UNRESTRICT_SECONDS=2

# ---- group acquisition (VPN trial invitations) ----
# Someone asking about a VPN in the group is a customer the VPN bot has not met
# yet. This bot notices, asks the VPN bot for a personal invitation link over a
# signed internal endpoint, and posts that link in the group. It never sees a
# credential, a client or a subscription link — the VPN bot owns all of that,
# and the test itself is delivered in a private chat.
#
# Set GROUP_TRIAL_ENABLED=0 to switch it off without touching the VPN bot.
GROUP_TRIAL_ENABLED=1

# Where the VPN bot's internal service API is. The two run on different hosts
# (this one is a container, the VPN bot is a systemd service on the host), so
# this has to be an address the container can reach.
#
#   http://127.0.0.1:8099   <- what is deployed here. The container runs with
#                              `network_mode: host`, so it shares the host's
#                              network namespace and loopback is the host.
#   http://172.21.0.1:8099  <- the bridge gateway, if you go back to bridge
#                              networking. It only works when the host firewall
#                              lets the Docker range reach the port — otherwise
#                              it hangs, which looks like the VPN bot being
#                              down. See /opt/vpn-bot/AGENTS.md §13.9.
#
# The port must not be open to the internet. The VPN bot binds it to loopback
# by default and every request is signed.
VPNBOT_API_URL=http://127.0.0.1:8099

# Must match SERVICE_SHARED_SECRET in the VPN bot's .env. Generate with:
#   openssl rand -hex 32
# Empty disables the feature: no invitation is ever sent, and no VPN operation
# of any kind can run.
#
# What this secret buys has grown. It used to authorise exactly one thing —
# asking whether the VPN bot wanted to invite somebody. It now also authorises
# the operational surface: subscription and service lookups, and six
# administrative writes. That is why the surface is gated three more times:
#
#   1. ``vpn.read`` / ``vpn.manage`` are carried by no role bundle, so every one
#      of them is the owner's alone. See app/rbac.py.
#   2. Three of the six writes move money or reject orders. They are not
#      executed when asked for — they are recorded and the owner must approve
#      them in a second, separately authorised step. See app/vpn_service.py.
#   3. The VPN bot has its own switch (INTERNAL_API_ADMIN_ENABLED) that closes
#      its write surface independently of anything here.
VPNBOT_SHARED_SECRET=

VPNBOT_TIMEOUT_SECONDS=8

# How long a recorded VPN operation stays confirmable, in seconds. Long enough
# for the owner to read the question and reply; short enough that a forgotten
# operation does not stay armed for a day. Only applies to the three operations
# that move money or reject orders.
VPN_CONFIRMATION_TTL_SECONDS=900

# The rules that decide what counts as someone asking for a VPN live in
# app/intent_rules.json. Point this at another file to override them on a
# running deployment without rebuilding the image. See app/intent.py.
INTENT_RULES_PATH=

# Whether a message must be *about* circumvention before it counts. Left on,
# «اینترنتم ضعیفه» is not an intent — half the group complains about slow
# internet, and offering all of them a trial is noise. Turn it off and a
# connectivity complaint alone is enough.
INTENT_REQUIRE_TOPIC=1

# Shortest message worth looking at, in characters after normalisation.
INTENT_MIN_LENGTH=4

# How long a user is left alone after being offered a test, in seconds. Kept in
# the database, so a restart does not reset it and hand the same person a
# second invitation.
INTENT_COOLDOWN_SECONDS=3600

# The in-group reply. Only {name} is substituted. The group never receives a
# configuration, a subscription link or a credential.
GROUP_TRIAL_BUTTON=🎁 دریافت تست رایگان
GROUP_TRIAL_HINT=تست ۵۰۰ مگابایت و ۱ روزه‌ست و فقط یک‌بار به هر کاربر داده می‌شه.

# The reply is chosen from what the message was about, so a complaint about a
# slow connection is not answered with the same words as a question about price.
# The AI layer returns a key naming one of these; it never writes the sentence,
# so every word below is yours. Only {name} is substituted.
#
# Leave these commented out to use the built-in wording. Do NOT set one to an
# empty value: os.getenv returns the empty string rather than the default, and
# the reply would go out blank.
#GROUP_TRIAL_REPLY_CONNECTIVITY=
#GROUP_TRIAL_REPLY_ACCESS=
#GROUP_TRIAL_REPLY_VPN=
#GROUP_TRIAL_REPLY_PRICING=

# ---- group acquisition: the AI second opinion ----
# The rules in app/intent_rules.json are the decision. They are fast, free,
# offline and auditable, and they keep working with everything below switched
# off. What they cannot do is judge a sentence they were never written for.
#
# So there is a second, optional layer: a message that hits the `ai_candidates`
# group in the rules file (but does not settle the question either way) is sent
# to Gemini, which returns a structured classification - relevant or not,
# category, confidence. That answer can promote a message the rules missed and
# can confirm one they flagged; it can never overturn a rule match or a veto.
# The model never writes anything to anyone: the bot decides what to send, and
# what it sends is the same invitation it always sent.
#
# This layer is an optimisation. It is not a dependency. Read
# AgentMD.md §13.8 before changing any of it.
GEMINI_ENABLED=true

# The API key, from Google AI Studio. Empty (the default) makes the whole layer
# inert and the bot behaves exactly as it did before it existed.
#
# This is a secret. Never commit it, never paste it into a log or a report, and
# never put it in a group message. There is a test that fails if it reaches a
# log line. The rest of this block is only read when the key is set.
GEMINI_API_KEY=

# The model. Chosen by measurement, not by documentation: the documented
# `gemini-flash-latest` alias answered 0 of 8 calls against this deployment's
# free-tier key (503 UNAVAILABLE / 504 DEADLINE_EXCEEDED, sustained), while
# `gemini-flash-lite-latest` answered 8 of 8 and classified every probe message
# correctly. Lite is also the right size for judging one short message: faster,
# and cheaper against the daily quota.
#
# If availability shifts, measure it again rather than assuming — this is one
# env var and needs no rebuild.
GEMINI_MODEL=gemini-flash-lite-latest

# Hard bound on one call. A stalled socket must never hold up a group message.
#
# 10 is the API's own floor, not a preference: it rejects a manually-set
# deadline below 10 seconds with `400 INVALID_ARGUMENT ... Minimum allowed
# deadline is 10s`, so a smaller number makes every call fail while the layer
# still reports itself active. The code clamps to 10 regardless of what is set
# here, so this can only ever make the bound longer, never illegal.
GEMINI_TIMEOUT_SECONDS=10.0

# Retries are for transient failures only (429, 5xx, timeouts), with backoff.
# A malformed answer is not retried: it will be malformed again, and it has
# already been counted against the day.
GEMINI_MAX_RETRIES=1
GEMINI_BACKOFF_SECONDS=1.5

# A wall-clock ceiling on ONE logical request, on top of the per-attempt
# deadline and the attempt count. Those bound how many calls are spent; this
# bounds how long the caller waits. It exists for the classifier alone, because
# its caller is the group-message handler that offers a trial: without it, the
# pool's failover walk (every account, every model, retries each, capped at
# GEMINI_POOL_MAX_ATTEMPTS) can hold that handler for minutes.
#
# The default is one retry — two attempts at the full deadline plus the backoff
# between them. 0 means no ceiling, which is what every other workload has.
GEMINI_INTENT_TIME_BUDGET_SECONDS=21.5

# Our own rate ceiling: at most this many calls per window. Set below the free
# tier's published RPM so that a burst of chatter degrades to the rule engine
# instead of earning a 429 that would also break the calls we wanted.
GEMINI_RATE_LIMIT=10
GEMINI_RATE_WINDOW=60.0

# A hard daily ceiling. The free tier's requests-per-day resets at midnight
# Pacific; this counter is persisted in the database and resets on the same
# boundary (never later), so a container restart cannot hand us a fresh
# allowance. When it is reached the layer simply stops being consulted.
GEMINI_DAILY_LIMIT=400

# Consecutive transport failures that open the circuit breaker, and how long it
# stays open. Going quiet for five minutes is cheaper than hammering a service
# that is down, and a group does not need an offer every minute.
GEMINI_CIRCUIT_FAILURES=5
GEMINI_CIRCUIT_SECONDS=300.0

# The confidence below which the model's own "yes" is not acted on.
GEMINI_MIN_CONFIDENCE=0.55

# The message is truncated to this many characters before it leaves the server.
# A group message is short; a pasted wall of text is not worth the tokens.
GEMINI_MAX_CHARS=600

# ---- the conversational assistant: a second, independent Gemini budget ------
# Answers people who talk TO the bot — a private message, a reply to a bot
# message, or an @mention. It never runs on an ordinary group message.
#
# IMPORTANT: Gemini applies rate limits PER GOOGLE CLOUD PROJECT, not per API
# key. Two keys in the same project share one allowance, so a separate key only
# gives a separate budget if it belongs to a different project. That is the
# whole point here: a chatty user must not be able to exhaust the acquisition
# classifier's daily quota, and vice versa.
#
# Verified against https://ai.google.dev/gemini-api/docs/rate-limits on
# 2026-09-21: "Rate limits are applied per project, not per API key. Requests
# per day (RPD) quotas reset at midnight Pacific time."
#
# A Gemini app subscription is NOT an API quota. The API is bounded by the API
# usage tier (Free / Tier 1 / Tier 2 / Tier 3) of the project the key belongs
# to, whatever the Google account pays for elsewhere.
#
# Google publishes no static free-tier table any more — limits are per project
# and must be read from AI Studio (aistudio.google.com/rate-limit) for the
# account in question. The defaults below are deliberately conservative; put the
# real measured ceilings here once known.
GEMINI_CHAT_ENABLED=0

# Leave EMPTY until you have a key from a DIFFERENT project than GEMINI_API_KEY.
# Never commit this. Never log it; `status()` cannot print it.
GEMINI_CHAT_API_KEY=

# Allow the assistant to fall back to GEMINI_API_KEY when the line above is
# empty. OFF by default, and deliberately explicit, because of what it costs:
# Google applies rate limits per PROJECT, not per key, so a shared key means a
# shared Google allowance even though this application keeps separate counters.
# A busy conversation can then push the classifier into a 429, at which point it
# degrades to the rule engine — safe, but a real behaviour change.
#
# What is NOT shared either way: the counters, the daily cap, the rate window
# and the circuit breaker inside this application. Chat can never spend the
# classifier's allowance or trip its breaker; that is asserted in
# tests/test_chat.py. Set this to 1 to make the assistant work on a deployment
# with a single key. Leave it 0 and supply GEMINI_CHAT_API_KEY from a second
# Google Cloud project for genuinely independent quotas.
GEMINI_CHAT_ALLOW_SHARED_KEY=0

# Its own model setting, because it is a different job: a longer reply, read by
# a human, is worth a stronger model than a one-word classification.
#
# Measured on the live key 2026-09-21 (see app/config.py for the full note):
# `gemini-flash-lite-latest` and `gemini-3.5-flash-lite` answer well in Persian;
# `gemini-flash-latest` is a thinking model that returns no visible text at a
# small output budget; `gemini-2.5-flash` and `gemini-2.5-flash-lite` now 404
# ("no longer available"). Prefer the `-latest` alias over a pinned version.
GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# Longer than the classifier's 10s: a person waiting for a considered reply
# will wait, a group message being classified cannot. Still bounded.
GEMINI_CHAT_TIMEOUT_SECONDS=25.0
GEMINI_CHAT_MAX_RETRIES=1
GEMINI_CHAT_BACKOFF_SECONDS=1.5

# Its own brake, lower than the classifier's: each request is larger, and a
# person can only read so fast.
GEMINI_CHAT_RATE_LIMIT=6
GEMINI_CHAT_RATE_WINDOW=60.0

# The daily allowance, PER ACCOUNT — not for the whole bot.
#
# It is handed to the chat pool, which spends one account's day and then fails
# over to the next, exactly as it does for a 429. So the number of chat requests
# a deployment can serve per day is this value times the number of configured
# chat accounts: with GEMINI_CHAT_API_KEY and GEMINI_CHAT_API_KEY_2 both set,
# 200 here means 400 a day, and the bot says "the daily quota is used up" only
# when BOTH have spent their own 200.
#
# That is the fix for a real incident: a single shared counter reached its
# ceiling while a second configured key with a full day sat unused, and the
# group was told its quota was gone when it was not. Two keys bought nothing,
# because the cap was not a property of a key.
#
# The day is the provider's own API day (midnight Pacific), not local midnight,
# so the allowance returns when the provider's quota does. It comes back on its
# own — nothing has to fire at midnight and nothing needs restarting.
#
# /chat reports the remaining figure across the whole pool, so you can see the
# real number rather than working it out.
GEMINI_CHAT_DAILY_LIMIT=200
GEMINI_CHAT_CIRCUIT_FAILURES=5
GEMINI_CHAT_CIRCUIT_SECONDS=300.0

# One person's own brake, keyed by (chat, user). The window above bounds the
# whole deployment; this bounds a single conversation, so nobody can hold down
# the send key and spend the day's allowance before anyone else gets a reply.
GEMINI_CHAT_USER_RATE_LIMIT=5
GEMINI_CHAT_USER_RATE_WINDOW=30.0

# One incoming message is truncated to this before it leaves the server.
GEMINI_CHAT_MAX_CHARS=1500

# Conversation memory: turns replayed to the model, and how long a quiet
# conversation is remembered. Bounds growth from both directions.
GEMINI_CHAT_HISTORY_TURNS=8
GEMINI_CHAT_HISTORY_TTL=1800

# Telegram's hard limit is 4096; the margin is for escaping.
GEMINI_CHAT_REPLY_CHARS=3500

# The two pieces of copy a user can trigger themselves. The reply text itself is
# NOT configurable — that is the model's, and the output boundary in
# app/chat.py is what decides what it may contain.
GEMINI_CHAT_RESET_TEXT=گفتگو پاک شد. از نو شروع کن 🙂
GEMINI_CHAT_START_TEXT=سلام {name} 👋


# ---- Gemini: the awareness workload -----------------------------------------
# A SIXTH independent workload, separate from intent, chat, moderation,
# transcribe and tts: its own key, model, deadline, retries, breaker, counters
# and daily allowance. It exists so that an observant Nexus can never spend the
# allowance a person is waiting on an answer to, and so that a Gemini outage
# that trips one breaker leaves the other path working.
#
# REQUIRED for awareness to run at all. There is no fallback: with this empty,
# the awareness workload has no credential and does no work, which is reported
# at boot. That is deliberate — a workload that cannot run on its own allowance
# does not run on somebody else's.
#
# Use a key from a DIFFERENT Google project than the chat key. Sharing a project
# means sharing one provider-side rate limit that no per-workload counter can
# partition; on the deployment that prompted this, awareness and chat sharing a
# key cost 26% of conversational turns to rate limits.
GEMINI_AWARENESS_API_KEY=

# Allow the awareness workload to draw on the SHARED pool (GEMINI_KEY_*) as well
# as its own key above. Off by default, and it does NOT re-enable a fallback to
# the chat key — that path is gone. Turn this on only if you keep several
# project-independent keys in the shared pool and accept that awareness may then
# contend with another workload for one of them.
GEMINI_AWARENESS_ALLOW_SHARED_KEY=0

# Its own model, defaulting to the chat model. Same job shape as chat — read
# Persian, produce a short structured answer — so the same model is a sensible
# default; override it if the ambient prompt ever needs something else.
GEMINI_AWARENESS_MODEL=gemini-flash-lite-latest

# Shorter than chat's 25s: an ambient pass reads a batch on a timer, and a slow
# pass delays the next tick rather than a person.
GEMINI_AWARENESS_TIMEOUT_SECONDS=20.0
GEMINI_AWARENESS_MAX_RETRIES=1
GEMINI_AWARENESS_BACKOFF_SECONDS=1.5

# Its own breaker, so a run of awareness failures cannot silence the
# conversational path — and vice versa.
GEMINI_AWARENESS_CIRCUIT_FAILURES=5
GEMINI_AWARENESS_CIRCUIT_SECONDS=300.0


# ---- outbound AI connectivity: which IP family ------------------------------
# Order the AI hostnames' resolved addresses IPv6-first, so the AI calls leave
# over IPv6 when the host can reach it and fall back to IPv4 when it cannot.
#
# It is a REORDER, never a filter: every IPv4 address stays in the list, so the
# failure mode of being wrong here is a slower call, not a call that cannot be
# made. It also declines by itself on a host with no global IPv6 address, so
# leaving it on is safe anywhere. See app/net.py and AgentMD.md §18.
#
# The startup log line "AI egress: ..." reports what actually happened.
AI_PREFER_IPV6=1


# ---- bot identity -----------------------------------------------------------
# The bot's id and username come from Telegram itself (getMe at startup) and are
# what reply-to-bot and @mention matching use. BOT_ALIASES is for the *human*
# names the group actually uses — the Persian word for "robot", a nickname.
#
# Empty by default, and deliberately separate from the username: matching a bare
# word is a heuristic, and a heuristic that decides whether the bot speaks
# should be an operator's decision rather than an assumption this file makes.
# Entries are matched case-insensitively as whole words, so `گارد` does not match
# `گاردین`.
BOT_ALIASES=

# How long a Telegram chat-member lookup is trusted, in seconds. The admin check
# is a live API call and an ordinary member can trigger it by talking; caching is
# what stops that being a way to spend the bot's rate limit. Short enough that a
# demotion takes effect quickly.
ADMIN_CACHE_SECONDS=300


# ---- authorization (RBAC) ---------------------------------------------------
# The primary owner, by Telegram user id. This is the highest application-level
# authority and it is IMMUTABLE AT RUNTIME: no command, no button and no group
# message can create it, change it or take it away. It is a deployment fact,
# which is exactly what makes it safe to compare against.
#
# 0 means "no owner configured", in which case EVERY administrative command is
# refused (fail closed) and the startup log says so loudly. It does not fall back
# to "the first admin wins" or "the whitelist is the owner" — those are both ways
# for the wrong person to end up in charge.
#
# Find your own id by messaging the bot and reading the log, or with @userinfobot.
OWNER_USER_ID=0

# Roles seeded from configuration at startup, format `<user_id>:<role>`, comma
# separated. Roles: helper, moderator, senior_admin. (The owner is OWNER_USER_ID
# alone and is not assignable.)
#
# This exists so a deployment can come up with its staff already in place, and it
# is the only way to recover if the admins table is lost. An entry naming a role
# that does not exist is skipped rather than fatal.
#
#   helper       — see the review queue, warn a user
#   moderator    — + delete a message, mute a user
#   senior_admin — + ban, promote/demote, change configuration
CONFIG_ADMINS=


# ---- AI-mediated administration ---------------------------------------------
# The assistant can propose administrative actions — ban, mute, promote and the
# rest — as typed tool calls. It never touches Telegram itself and never decides
# anything: every call it produces is re-authorised by app/rbac.py against the
# real Telegram sender id before anything happens. This switch controls whether
# the model is *offered* the tools, not what any tool requires.
#
# Turning it off cannot widen anybody's authority, and cannot take administration
# down: the direct commands below are a separate interface onto the same
# execution layer. A Gemini outage degrades the group to commands, not to chaos.
ADMIN_AI_ENABLED=true

# Whether the direct commands (/ban, /mute, /promote, ...) work. This is the
# fallback interface, so the default is on. Turning it off makes the model the
# only way to administer the group — which is a deliberate choice for a
# deployment that wants one interface, and a bad one for a deployment that wants
# to survive a provider outage.
ADMIN_PYTHON_ENABLED=true

# The replay window, in seconds. A request the model produced is stamped when it
# is produced and must run in the same turn; anything older is refused as stale,
# because a request that has been sitting somewhere is the shape of a replay.
# 0 disables the check.
ADMIN_REQUEST_REPLAY_WINDOW=120

# How long a request id is remembered, so the same request cannot be carried out
# twice. The floor is the replay window above — a request must not be forgotten
# while it is still replayable — and the floor is applied in code rather than
# trusted to this value, because getting it wrong fails silently.
ADMIN_IDEMPOTENCY_RETENTION=86400

# How long the administrative audit trail is kept, in seconds. The default is 90
# days: the trail is the answer to "who did this", and refusals are written to it
# as well as successes, because the question after an incident is who tried.
# Pruning runs on the administrative path; this process has no scheduler.
ADMIN_ACTIVITY_RETENTION=7776000

# How many recent administrative events the assistant may see when it asks for
# context, and over what window, in seconds. Two bounds because they fail
# differently: the count keeps a busy room from filling the prompt, the window
# keeps a closed incident from being re-litigated. This is the only
# administrative history that reaches the model.
ADMIN_CONTEXT_LIMIT=12
ADMIN_CONTEXT_WINDOW=21600

# How many tool calls one turn may contain before the loop stops and the
# assistant answers with what it has. A bound rather than a timeout, because the
# failure mode is a model that keeps asking. Every call is still authorised
# individually.
ADMIN_TOOL_MAX_CALLS=4

# Whether an ordinary member — not an administrator — is offered the read-only
# tools. Off by default. The write tools are decided by RBAC and are never
# affected by this setting; what this governs is whether a member can ask "what
# is my role?" and "who are the admins?". Those answers are not secrets inside a
# group, but they are also not free: offering tools at all sends every tool
# declaration with every message, and for a member that is the price of nothing.
ADMIN_TOOL_GUEST_TOOLS=false


# ---- Nexus: the conversational layer's state, audience and memory ------------
# "Nexus" is the name this project gives the conversational layer as a *role*:
# natural-language understanding, context, intent and orchestration. It is not a
# model. Which provider and model answer is decided by the GEMINI_CHAT_* settings
# above and by the pool; changing them does not change what Nexus is.
#
# Nexus may *ask*; app/admin_service.py decides and executes. Nothing in this
# section widens anybody's authority — these settings choose who Nexus listens
# to, when it is awake, and how much it remembers.

# Whether Nexus answers only authorized administrators, or anybody who addresses
# it. On by default, and that default is a product decision: an ordinary member
# must not be able to activate the assistant by replying to it, mentioning it, or
# wording an administrative-sounding request. With this on, an unauthorized
# message costs one dictionary lookup and is never sent to Gemini.
#
# Turning it off restores the older behaviour, where the assistant answered any
# member who addressed it directly. It never changes what an *action* requires:
# every tool call is authorised against the real actor id either way.
#
# The value in force is reported by `/nexus status` as the "پاسخ‌دهی به" line, so
# an operator can tell from inside the group whether a silent member was refused
# by this gate or by something further in.
NEXUS_ACTORS_ONLY=true

# The two labels `/nexus status` prints for NEXUS_ACTORS_ONLY, reading as answers
# to "پاسخ‌دهی به" ("answers to"). They are deliberately distinct from the
# observe labels so a rendered status says which switch is which.
NEXUS_ACTORS_ONLY_ON_LABEL=فقط مدیرها
NEXUS_ACTORS_ONLY_OFF_LABEL=همه

# The names Nexus answers to, in addition to the bot's own username and
# BOT_ALIASES. A group calls the assistant by its role rather than by a username
# nobody can mention, and "نکسوس" is not an @mention. Matched as whole words,
# case-insensitively, and only to decide that a message is *aimed at Nexus* — it
# is not an authority of any kind. Comma separated.
NEXUS_NAMES=nexus,نکسوس

# Whether Nexus records what an authorized administrator says when they are not
# talking to it. This is the "watch without replying" behaviour: the message is
# stored in that administrator's own bounded conversation context and nothing is
# sent. It is what lets a later "بنش کن" be understood as a follow-up to "این
# کاربر خیلی مزاحم شده". Costs one row per administrator message and no AI call.
NEXUS_OBSERVE_ADMINS=true

# Extra words that make an unaddressed message a *timing hint*. The built-in
# lexicon (in app/nexus.py) covers the Persian and English verbs of moderation;
# this is the escape hatch for a room whose slang it does not know. Comma
# separated, matched as whole words.
#
# Since Group Awareness this is a hint and nothing more: it asks the awareness
# layer to read that room on its next tick instead of waiting for the debounce,
# and the room then goes through exactly the same pass. It cannot make a message
# relevant, cannot make it be acted on, and cannot pre-empt the model's single
# semantic decision — so a wrong entry costs a slightly early read, never an
# action.
NEXUS_EXTRA_ACTION_WORDS=

# The identity memory: the mapping from a name somebody said out loud to the
# Telegram user id that actually identifies them. It records names and usernames
# only, for people who have spoken in a monitored group; there is no column for a
# message body, and no code path writes one. A row is written for every speaker,
# including people with no role at all, and it grants nothing — authority is
# resolved separately, from the Telegram id, in app/rbac.py.
NEXUS_PEOPLE_ENABLED=true

# A ceiling on the identity table. The least recently seen rows are dropped
# first, so a busy group keeps the people who are actually present.
NEXUS_PEOPLE_MAX=5000

# And an age bound, in seconds, so somebody who left months ago does not stay
# resolvable forever. Pruned on the observation path, because this process has no
# scheduler. Default 90 days.
NEXUS_PEOPLE_RETENTION=7776000

# How many candidates a name lookup may return when several people share a name.
# Not a matching threshold — a match is an exact, normalised comparison — this
# only bounds what is shown to the model before it is required to ask which one.
NEXUS_PEOPLE_MAX_CANDIDATES=8


# ---- Nexus Group Awareness: understanding the room --------------------------
# Nexus follows the group conversation continuously, with Gemini as the layer
# that decides what matters. The distinction the whole block serves:
#
#     understanding what is happening   ≠   deciding to speak
#
# Nexus is aware of every message it can receive, and answers very few of them.
# Whether a conversation concerns Nexus is a *semantic* question and belongs to
# the model; there is no keyword list in that decision, and none may be added.
# Everything below is about timing, cost, bounds and retention — never meaning.
#
# Awareness observes and never authorises. Every tool call is authorised
# separately against the Telegram id of the person who actually spoke last, so a
# member whose message is understood still cannot produce an action.
#
# This is the *deploy-time* master switch: it is read once and cannot change
# without a restart. The owner also has a spoken switch — «آگاهی خاموش» /
# «آگاهی روشن» — which turns the layer off and on at runtime, with no restart,
# and persists. The layer runs when both say yes; see NEXUS_AWARENESS_NAMES and
# the confirmations further down.
NEXUS_AWARENESS_ENABLED=true

# How often the sweeper looks for a group with something new to understand. A
# tick that finds nothing costs one indexed query per configured group and no
# API call at all, which is what makes this interval affordable.
NEXUS_AWARENESS_TICK_SECONDS=15

# Wait for the room to go quiet for this long before reading it. This is the
# whole reason awareness does not cost one API call per message: a burst of
# twenty messages is one pass, not twenty.
NEXUS_AWARENESS_DEBOUNCE_SECONDS=8

# A busy room never goes quiet, so this is the ceiling on how long a message may
# sit unread. Whichever comes first — the room falling silent, or this much time
# passing since the oldest unread message — triggers the pass.
NEXUS_AWARENESS_MAX_WAIT_SECONDS=45

# A floor between two passes in the same group, so a continuously busy room is
# understood at a steady bounded rate rather than as fast as messages arrive.
# The timing hint from NEXUS_EXTRA_ACTION_WORDS can skip the debounce above and
# deliberately cannot skip this.
NEXUS_AWARENESS_MIN_INTERVAL_SECONDS=20

# The bounded room window: how many recent messages are shown to the model, and
# how many characters they may occupy in total. Both bounds apply — a count bound
# alone lets many long messages become a huge prompt, and a character bound alone
# lets a flood of one-word messages push the real context out.
#
# The count is sized against the *cadence*, not against itself: the daily
# allowance is spread evenly across the API day, so on the default limit of 200 a
# room is read about once every nine minutes. A window smaller than one interval
# silently loses the messages in between — and loses them for good, because a
# pass records the newest unread id as understood. 150 covers one interval at the
# message rate this deployment sees, which is when the character bound becomes
# the real guard rather than a decorative one. Raising this costs nothing in the
# currency that is rationed: NEXUS_AWARENESS_DAILY_LIMIT counts requests, not
# tokens.
NEXUS_AWARENESS_WINDOW_MESSAGES=150
NEXUS_AWARENESS_WINDOW_CHARS=6000

# How long a captured message is kept, in seconds. The window is a *recent view*
# of the group, not a transcript, so rows older than this are dropped — which is
# what stops the table from becoming a permanent record of the conversation.
NEXUS_AWARENESS_RETENTION_SECONDS=3600

# A ceiling on the table as well as on the age, because a busy hour can produce
# more rows than the age bound alone would remove. Applied per group, oldest
# first.
NEXUS_AWARENESS_MAX_ROWS=400

# How many groups one tick may read. Keeps a slow pass from starving the rest of
# the bot.
NEXUS_AWARENESS_MAX_CHATS_PER_TICK=2

# The awareness workload's own daily ceiling, per Gemini account — exactly as
# GEMINI_CHAT_DAILY_LIMIT is per account. When it is spent, awareness stops for
# the day and the assistant keeps answering: the two budgets are separate on
# purpose, so an observant Nexus can never spend the allowance a person is
# waiting on an answer to.
NEXUS_AWARENESS_DAILY_LIMIT=200

# How many recent messages are replayed when Nexus *answers* somebody directly.
# This is the same window, sized for a prompt that also carries the current turn
# and the administrative context.
NEXUS_AWARENESS_CONTEXT_MESSAGES=20

# ---- The staged context ------------------------------------------------------
#
# An awareness pass is handed the transcript plus whatever else the server
# already knows about the room. That extra context is assembled from *sources*
# (see app/awareness_context.py) so that the cheap half is always there and the
# expensive half is only built when the batch calls for it. The awareness
# allowance is rationed in requests, so context nobody asked for is paid on
# every pass.
#
# NEXUS_AWARENESS_CONTEXT_CHARS is the hard ceiling on all of it together; each
# source has its own cap beneath it. NEXUS_AWARENESS_CONTEXT_DEEP is the kill
# switch for the conditional tier — the half that reads the database. Switching
# it off leaves the free context (the room's name, and who was here last time)
# and removes every extra query a pass could make.
NEXUS_AWARENESS_CONTEXT_CHARS=1500
NEXUS_AWARENESS_CONTEXT_DEEP=true

# How many recent administrative actions the context may show, and how many
# people it may describe. Both are bounded because this is context rather than a
# directory: the point is that a pass can see what has just happened here and
# who the batch is about, not that it can enumerate the room.
NEXUS_AWARENESS_ADMIN_ACTIONS=5
NEXUS_AWARENESS_REFERENCED_PEOPLE=4

# Sent when an awareness pass actually performed an action but the model gave no
# wording for it. Rare, and the alternative is worse: an administrator whose
# instruction was carried out and never acknowledged believes it was ignored and
# repeats it. The action's own outcome is in the audit log either way.
NEXUS_AWARENESS_ACTION_TEXT=انجام شد ✅

# The two labels `/nexus status` prints for the awareness layer, reading as
# answers to "درک گفتگوی گروه" ("understanding of the group conversation").
# Reported for the same reason the actor gate is: awareness is silent by design,
# so "Nexus ignored what we said" and "awareness is switched off" look identical
# from inside a group, and only one of them is a bug. They report the *effective*
# state — this setting and the owner's spoken switch together — because that is
# what the gates act on.
NEXUS_AWARENESS_ON_LABEL=فعال
NEXUS_AWARENESS_OFF_LABEL=غیرفعال

# The words that name *this layer* when the owner switches it by message. They
# exist to tell «آگاهی خاموش» (stop reading the room) apart from «نکسوس خاموش»
# (stop answering): the two share the verb «خاموش», so the router has to know
# which noun was used before it can decide which switch was meant, and this list
# is that answer. Matched as whole words, case-insensitively.
#
# «اورنس» is included because it is what the owner actually typed — a
# transliteration of "awareness" that is in no dictionary and in NEXUS_NAMES
# nowhere, which is exactly how the original confusion arose.
#
# «پایش» is the odd one out: it is a *description* of the layer rather than a
# name for it, and it is here because the owner addresses the layer that way —
# «قطع کن این پایش رو» ("stop this watching"). Without it the router reads the
# verb «قطع کن», finds no awareness name in the message, and silences the
# *assistant* instead of the layer, which is the exact confusion this list
# exists to prevent. It is a setting precisely so an operator who finds «پایش»
# too general can take it out without touching code.
NEXUS_AWARENESS_NAMES=awareness,اورنس,آگاهی,اگاهی,پایش

# The two confirmations for the spoken switch. They deliberately do NOT say the
# assistant is off: an owner who reads a bare «خاموش شد» after switching
# awareness off would reasonably conclude Nexus had stopped answering, which is
# the one thing this switch must never do. They name the layer and say the chat
# keeps working.
NEXUS_AWARENESS_OFF_DONE_TEXT=🙈 آگاهی خاموش شد. از این به بعد چت معمولی و سریع جواب میدم و اتاق رو تحلیل نمیکنم.
NEXUS_AWARENESS_ON_DONE_TEXT=👁 آگاهی روشن شد. از این به بعد اتاق رو هم تحلیل میکنم.

# Said when the switch is already in the state the owner asked for. "Nothing
# changed" and "it changed" are different facts, and a bare confirmation for a
# no-op is the sentence that makes an owner say "it doesn't work" about a switch
# that is already where they wanted it. {state} is the on/off label above.
NEXUS_AWARENESS_ALREADY_TEXT=آگاهی از قبل {state} بود.

# Said when the owner asks for the layer back and NEXUS_AWARENESS_ENABLED is
# false. A spoken command can only move the stored switch, not this setting, so
# the layer still will not run — and a confirmation that said otherwise would be
# exactly the kind of untrue status report this feature exists to remove. The
# fix is a restart, and only the operator can do it.
NEXUS_AWARENESS_CONFIG_OFF_TEXT=⚠️ آگاهی توی تنظیمات این ربات خاموش شده، پس با پیام روشن نمیشه. برای روشن کردنش باید NEXUS_AWARENESS_ENABLED=true باشه و ربات ریاستارت بشه.


# ---- Gemini: the moderation / content-understanding layer -------------------
# A THIRD independent Gemini workload, separate from the acquisition classifier
# and the conversational assistant: its own key, model, rate window, daily cap,
# circuit breaker, counters table and client.
#
# What it is for: understanding what a piece of group TEXT is, well enough for a
# deterministic policy to act on. The local pattern filter answers one narrow
# question (does this match a known bad pattern); this answers the wider one —
# harassment, a threat, a slur, a scam pitch, an explicit proposition.
#
# It is text-only. The media moderation pipeline that used to feed it a local
# visual detector was removed, so a photo, video or GIF is no longer sent here
# and no longer enters any content-moderation path — the media handler that
# remains only counts a flood from message metadata.
#
# What it is NOT for: it never executes anything. It cannot delete, restrict, ban
# or reply. Its output is data, and the decision to act is made in code by
# app/mod_policy.py. There is no code path from its return value to a Telegram
# call, which is why a prompt-injected group message cannot make the bot do
# anything.
#
# This is the heaviest of the workloads, so it is the one that most needs its own
# Google Cloud project.
GEMINI_MOD_ENABLED=0
GEMINI_MOD_API_KEY=
GEMINI_MOD_ALLOW_SHARED_KEY=0
GEMINI_MOD_MODEL=gemini-flash-lite-latest
GEMINI_MOD_TIMEOUT_SECONDS=20.0
GEMINI_MOD_MAX_RETRIES=1
GEMINI_MOD_BACKOFF_SECONDS=1.5
GEMINI_MOD_RATE_LIMIT=20
GEMINI_MOD_RATE_WINDOW=60.0
GEMINI_MOD_DAILY_LIMIT=500
GEMINI_MOD_CIRCUIT_FAILURES=5
GEMINI_MOD_CIRCUIT_SECONDS=300.0
GEMINI_MOD_MAX_CHARS=2000


# ---- media understanding (the assistant's) ----------------------------------
# One builder turns Telegram media into something Gemini can read. It is used
# only by the conversational assistant now — the moderation path that shared it
# was removed — so a sticker the assistant can see is just a sticker the
# assistant can see. Nothing here feeds any content moderation.
#
# Measured on this deployment's key on 2026-09-21, one real call each, which is
# what the inline-only design rests on:
#
#   image/png  OK    image/gif  OK    video/mp4  OK
#   video/webm OK    audio/wav  OK    audio/ogg  OK
#
# The Files API also works and is deliberately NOT used: it would leave a copy of
# a group member's media in Google's storage for no capability this bot needs.
# Telegram's own download ceiling is 20 MB, so inline covers everything.
GEMINI_MEDIA_MAX_MB=18.0
GEMINI_MEDIA_FRAMES=4
GEMINI_MEDIA_MAX_PARTS=6
GEMINI_MEDIA_MAX_SECONDS=60.0


# ---- the moderation policy --------------------------------------------------
# How sure we have to be before we destroy something. The defaults are the
# conservative end.
#
# This layer used to be fed by a local visual detector as well, and carried its
# settings — a hard threshold, a "delete without the AI" mode, a media switch.
# That whole media pipeline was removed, so a deletion now requires a confident
# AI verdict and nothing else.
MODERATION_ENABLED=1

# The AI's confidence must be at least this before its "clearly explicit"
# classification is acted on.
MODERATION_DELETE_CONFIDENCE=0.80
# The band below that which is still worth recording for a human.
MODERATION_REVIEW_CONFIDENCE=0.45

# Only `explicit_sexual` may ever be deleted. The others (suggestive, harassment,
# threat, spam) are carried, logged and reported so an operator can see them —
# which is the "recommend a future restriction" half of the architecture, made
# visible without being acted on.
MODERATION_DELETABLE_CLASSES=explicit_sexual

# Text moderation is OFF by default, and that is a judgement rather than an
# oversight: it is the one path left that can delete a person's WORDS, in a
# language the model may misjudge. The capability is implemented and tested.
# Turn it on after watching the review log for a while.
MODERATION_TEXT_ENABLED=0
MODERATION_TEXT_MIN_CHARS=25

# Report every REVIEW to the admin log chat, so "the bot stopped deleting" and
# "the bot stopped working" do not look the same from the outside.
MODERATION_REVIEW_NOTIFY=1



# ---- speech to text (the fourth workload) -----------------------------------
# Its own key, model, limits and breaker. Separate from the assistant on purpose
# even though the assistant uses it: transcription is mechanical and has one
# right answer, while a reply is a generation, and sharing a budget would make
# "the transcript was wrong" indistinguishable from "the reply was wrong".
#
# This is also what keeps ordinary group voice messages out of acquisition and
# moderation: nothing transcribes a voice note unless something explicitly asks.
# There is no handler that does so automatically.
TRANSCRIBE_ENABLED=0
TRANSCRIBE_API_KEY=
TRANSCRIBE_ALLOW_SHARED_KEY=0
TRANSCRIBE_MODEL=gemini-flash-lite-latest
TRANSCRIBE_TIMEOUT_SECONDS=25.0
TRANSCRIBE_MAX_RETRIES=1
TRANSCRIBE_BACKOFF_SECONDS=1.5
TRANSCRIBE_RATE_LIMIT=10
TRANSCRIBE_RATE_WINDOW=60.0
TRANSCRIBE_DAILY_LIMIT=300
TRANSCRIBE_CIRCUIT_FAILURES=5
TRANSCRIBE_CIRCUIT_SECONDS=300.0
TRANSCRIBE_MAX_SECONDS=300.0
TRANSCRIBE_MAX_MB=18.0

# The transcription-ONLY interface: a command that returns the transcript and
# nothing else, so the pipeline can be used and tested without the assistant
# being involved. Empty disables it.
TRANSCRIBE_COMMAND=transcribe


# ---- voice replies from the assistant ---------------------------------------
# When somebody talks to the assistant with a voice message, answering in voice
# is the natural thing to do — and it works: the TTS models below were measured
# on this key on 2026-09-21, returning raw PCM at 24 kHz mono, which ffmpeg turns
# into the OGG/Opus that Telegram's sendVoice wants.
#
# OFF by default, deliberately. A voice reply costs a second model call plus an
# ffmpeg pass, it cannot be read silently, and a synthetic voice is a much
# stronger claim to personhood than text is. The requirement is a natural
# conversation rather than a convincing impersonation, so this is an opt-in.
GEMINI_CHAT_VOICE_REPLY=0
GEMINI_CHAT_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_CHAT_TTS_VOICE=Kore
# Above this, the reply is sent as text instead.
GEMINI_CHAT_VOICE_MAX_CHARS=400

# How many media parts one conversational turn may carry.
GEMINI_CHAT_MEDIA_MAX_PARTS=3

# What the assistant says when an attachment could not be read at all. It is
# told not to guess what the media was, and this is what the person sees when
# even that is not possible.
GEMINI_CHAT_UNREADABLE_TEXT=این فایل رو نتونستم باز کنم 🙏 یه بار دیگه بفرست یا توضیح بده چیه.

# What the transcription-only command says when the message carries no audio.
TRANSCRIBE_NEED_AUDIO_TEXT=روی یک پیام صوتی ریپلای کن یا خودش رو با این دستور بفرست.
TRANSCRIBE_UNAVAILABLE_TEXT=الان نمی‌تونم صدا رو تبدیل کنم. بعداً دوباره امتحان کن.
TRANSCRIBE_EMPTY_TEXT=چیزی توی صدا نفهمیدم. واضح‌تر بفرست.


# ---- administrative command copy --------------------------------------------
# Every word the administrative interface says has a sensible Persian default in
# app/config.py and can be overridden here. They are not listed individually
# because there are about thirty and the defaults are what you want; the names
# all begin with ADMIN_, MOD_, or MODERATION_ and the full list with its
# annotations is in app/config.py. The ones worth knowing about:
#
#   ADMIN_DENIED_TEXT              what a refused command says
#   ADMIN_NOT_CONFIGURED_TEXT      what every command says when OWNER_USER_ID=0
#   ADMIN_OWNER_PROTECTED_TEXT     what a command aimed at the owner says
#   ADMIN_BOT_LACKS_RIGHT_TEXT     what it says when the BOT lacks the right
#   MOD_MUTE_DONE_TEXT             takes {name} and {minutes}
#
# Nothing here is a secret, and none of it is ever composed from model output.


# ---- the Gemini account pool: many keys, one AI service ---------------------
#
# Each workload above has one primary key. That is a pool of one, and a pool of
# one stops when that key's quota does. The pool adds more *accounts*
# behind the same workloads, so a request survives one of them running out:
# another compatible model on the same account first, then the next account.
#
# THE ONE RULE THAT SHAPES ALL OF THIS: every key below is a SEPARATE GOOGLE
# ACCOUNT AND A SEPARATE PROJECT, with its own quota. Two keys are not one
# bigger allowance. Nothing here merges them, and nothing here treats them as
# interchangeable — app/gemini_pool.py keeps a separate row per account with its
# own counters, cooldown and failure state, and a key that appears in two slots
# is collapsed to one account rather than counted twice.
#
# Read AgentMD.md §28 before changing any of it.
#
# ---- How to add accounts ----------------------------------------------------
#
# Shared pool: every workload may draw on these, in order, when its own keys are
# unavailable. Numbered slots are tried before the comma-separated list.
#
#   GEMINI_KEY_1=...
#   GEMINI_KEY_2=...
#   ... up to GEMINI_KEY_20
#
# One comma-separated list, if you prefer:
#
#   GEMINI_POOL_KEYS=key1,key2,key3
#
# Per-workload pool: extra accounts for ONE workload only, which is how you give
# the busiest workload a deeper pool without loosening the isolation of the
# others. The suffix goes up to 20.
#
#   GEMINI_API_KEY_2=...            the classifier's second account
#   GEMINI_CHAT_API_KEY_2=...       the assistant's second account
#   GEMINI_AWARENESS_API_KEY_2=...  group awareness's second account
#   GEMINI_MOD_API_KEY_2=...        moderation's second account
#   TRANSCRIBE_API_KEY_2=...        transcription's second account
#
# A workload uses its shared-pool keys only if its existing opt-in is on
# (GEMINI_CHAT_ALLOW_SHARED_KEY / GEMINI_AWARENESS_ALLOW_SHARED_KEY /
# GEMINI_MOD_ALLOW_SHARED_KEY / TRANSCRIBE_ALLOW_SHARED_KEY; the classifier
# always may). That is deliberate: the opt-in is the operator saying "these two
# workloads may share one Google allowance", and the pool must not make that
# decision for them.

# ---- Model preference -------------------------------------------------------
#
# The primary model of each workload is tried first; these are tried only when
# it is unavailable. A name that the provider does not list for a credential, or
# whose family cannot do the workload, is skipped rather than sent and rejected.
# Nothing here is invented: every name was returned by the live API on
# 2026-09-21, and the list is validated at request time rather than trusted.
#
#   GEMINI_FALLBACK_MODELS            classifier
#   GEMINI_CHAT_FALLBACK_MODELS       assistant
#   GEMINI_AWARENESS_FALLBACK_MODELS  group awareness
#   GEMINI_MOD_FALLBACK_MODELS        moderation (text)
#   TRANSCRIBE_FALLBACK_MODELS        transcription (must accept audio)
#   GEMINI_CHAT_TTS_FALLBACK_MODELS   speech synthesis (preview models only)

# Ask the provider which models each credential can actually see, and never try
# one it does not list. Verified against the live API: models.list returns
# names, token limits and supported generation methods, and NOTHING else — in
# particular it does not report input or output modalities. So discovery answers
# "does this model exist for this key"; capability stays a curated table in
# app/gemini_pool.py. A discovery failure means "do not filter", never "no
# models": losing an optimisation must not lose the request.
GEMINI_MODEL_DISCOVERY_ENABLED=true
GEMINI_MODEL_DISCOVERY_TTL=21600

# Cooldowns. Three different reasons a resource goes quiet, three lengths: a
# model rate limit clears in seconds to a minute, a project quota in minutes to
# hours, and a transient provider wobble almost immediately. A cooldown the
# provider actually sent (retryDelay) always wins over these.
GEMINI_POOL_MODEL_COOLDOWN=120
GEMINI_POOL_QUOTA_COOLDOWN=900
GEMINI_POOL_TRANSIENT_COOLDOWN=15

# Pool events are deduplicated per (workload, event, account, model) against
# this window, so a hundred consecutive 429s produce one row rather than a
# hundred.
#
# This setting used to be GEMINI_POOL_NOTIFY_COOLDOWN and it gated a Telegram
# message. That message is gone — the pool records events and never sends them
# anywhere, to any chat, including the admin log group and the owner's private
# chat. The deduplication is kept because it is what makes the events table a
# record of transitions rather than a copy of the counters.
#
# Read them with /pool, or from the gemini_events table. Nothing arrives
# unasked.
GEMINI_POOL_EVENT_COOLDOWN=900

# A hard ceiling on provider calls for one logical request. Without it a large
# pool with retries could spend a minute of wall clock on a single message.
GEMINI_POOL_MAX_ATTEMPTS=12

# ---- What the pool will not tell you ----------------------------------------
#
# Google does not publish remaining quota or reset times for these keys. The
# /pool command therefore prints "Not exposed by provider" for both, and reports
# the bot's own observed counters separately. There is deliberately no
# "requests remaining" figure anywhere in this codebase, because there is no
# honest way to compute one.

# ---- /keys: the owner's credential control plane -----------------------------
#
# The owner can add and remove Gemini credentials from Telegram, for chat,
# awareness and intent only. The full design is AgentMD.md §50; these are the
# settings.
#
# The credential added this way lives in one file, mode 0600, and nowhere else:
# not in the database, not in the audit trail, not in a log line, not in a
# Telegram message. It is plaintext in that file on purpose — the boundary is
# the file mode plus the container, and AgentMD.md §50.2 explains why an
# "encrypted at rest" scheme with the key in the same environment would be a
# lock with the key taped to it.
#
# The path must be inside the mounted data volume. Anywhere else and the first
# container rebuild silently loses every credential the owner added.
GEMINI_KEY_STORE_PATH=/data/gemini_keys.json

# How long the "send me the key now" prompt stays armed. Long enough to switch
# apps and copy a key, short enough that a prompt the owner walked away from is
# not still waiting to swallow the next thing they type.
GEMINI_KEY_ADD_TTL_SECONDS=300

# The deadline on the single verification call made before a key is stored. It
# lists models rather than generating anything, so it spends no generation
# quota. A key that cannot be verified is not stored — fail-closed.
GEMINI_KEY_PROBE_TIMEOUT_SECONDS=15

# A ceiling on runtime credentials per workload. It stops a loop from growing
# the store without bound; it is well above what a deployment needs.
GEMINI_KEY_MAX_PER_WORKLOAD=10

# The command name. Which workloads may be managed from Telegram is deliberately
# NOT a setting — a typo in an environment variable should not be able to widen
# the write surface. See AgentMD.md §50.4.
GEMINI_KEYS_COMMAND=keys
#
# Renaming it is safe and complete: the command menu Telegram is shown, the
# button on /start and /whoami, and the handler registration are all derived from
# this one value. See AgentMD.md §50.12.
#
# The menu itself needs no setting. The bot publishes its command list at startup
# — the public list to everybody, the administrative one (this command included)
# only to the owner's own chat — and a rename here is reflected the next time the
# container starts.

# ---- The coding-agent bridge -------------------------------------------------
#
# The owner can ask Nexus in the group for a code change, and Nexus hands the
# work to a coding agent on the host. The full design is AgentMD.md §39; this is
# the short version of what each setting does.
#
# The bridge is two processes. This container decides and records; a host
# process, tools/agent_runner.py, executes. They meet over a directory inside
# the bind mount the compose file already provides, so neither side needs a new
# port or a new shared secret.

# The master switch. Off means the tool is not declared, /agent says so, and no
# request is recorded.
AGENT_ENABLED=true

# The repository allowlist, as name=path pairs. A request names a NAME and the
# path is looked up here, so no expression a model can produce becomes a
# filesystem path. A path is accepted as input only when it is exactly one of
# these roots, and it is then converted back to the name.
#
# The host runner keeps its own copy of this list and checks the same thing
# again, because it is the process with the shell. Set this the same on both
# sides; if they disagree, the runner refuses rather than guesses.
AGENT_REPOSITORIES=guardbot=/root/guardbot,vpn-bot=/opt/vpn-bot

# How many tasks may be in flight at once, and how many on one repository.
# One per repository is the number that matters: two agents editing one working
# tree produce a state neither of them can describe. The global ceiling is about
# the host, which has two cores.
AGENT_MAX_ACTIVE=2
AGENT_MAX_PER_REPOSITORY=1

# Where the two halves meet. /data/agent in the container is
# /root/guardbot/data/agent on the host.
AGENT_SPOOL_DIR=/data/agent

# How often the container looks for progress and results. One directory listing
# per tick and no query when nothing is active, which is what makes a short
# interval affordable.
AGENT_POLL_SECONDS=3.0

# The run's bound. A task that has not finished in this long is stopped and
# reported rather than left to consume the host. A task that was published and
# never claimed is timed out on the same clock, because "the runner is down" is
# something the owner should be told.
AGENT_TIMEOUT_SECONDS=1800

# The agent's turn ceiling. The second bound, and the one that stops a loop
# early.
AGENT_MAX_TURNS=40

# ---- Read these two in the RUNNER's environment, not in this one -------------
#
# The container deliberately does not send the executable or its arguments. A
# container that could name an executable could name one that is not a coding
# agent, so which binary runs is the host's decision, set where the owner can
# see it.
#
# The correct invocation depends on how CodeBuddy is authenticated on the host.
# See AgentMD.md §39.15: the CLI's headless mode needs a working credential and
# a free loopback port, and the runner gives each run its own HOME so two runs
# can coexist. Pointing AGENT_CLI at a working invocation is the one deployment
# step only the owner can complete.
AGENT_CLI=codebuddy
AGENT_CLI_ARGS=-p,--output-format,stream-json,--model,deepseek-v4.1-flash,--permission-mode,acceptEdits,--no-session-persistence

# Pass --add-dir <repo> so a headless run never stops to ask permission to touch
# a path. A run that stops to ask a question nobody can answer looks exactly
# like a hang. Set to 0 for a CLI that does not accept the flag.
AGENT_ADD_DIR=1

# Where each run's isolated HOME goes. A fresh HOME per run is not tidiness: the
# CLI writes a loopback-port file into it and refuses to start if the port it
# recorded is already held by another session, so an isolated HOME is what lets
# two runs coexist at all.
AGENT_RUNNER_HOME=/run/guardbot-agent

# ---- How a long answer comes back -------------------------------------------
#
# A long response is chunked in order, or sent as a document, or both. There is
# deliberately no mode that discards it.
AGENT_CHUNK_CHARS=3500
AGENT_DOCUMENT_CHARS=3500

# Progress is throttled, because a chatty agent must not become a chatty bot.
# The final result is never throttled.
AGENT_PROGRESS_MAX_CHARS=600
AGENT_PROGRESS_MIN_INTERVAL_SECONDS=10
AGENT_PROGRESS_MAX_MESSAGES=20

# One "working" message, edited in place, instead of one message per progress
# line. The throttle above then limits edits rather than messages, and the answer
# at the end is still sent as its own message. Set to 0 for a message per line.
AGENT_WORKING_MESSAGE=true

# How long a finished task is kept before the retention prune drops it.
AGENT_RETENTION_SECONDS=1209600


# ---- Nexus Voice Live: the same assistant, with a microphone -----------------
# Nexus joins a Telegram voice chat and holds a realtime, spoken, bidirectional
# conversation. It is the same Nexus — the same awareness, the same authority
# model, the same audit trail — reached through a voice interface instead of a
# text one. It is not a second assistant and it does not get a second awareness:
# the live session reads the room through the *existing* awareness context and
# asks for an action through the *existing* authorisation path, exactly as a
# text turn does.
#
# The switch below defaults to **off**, and the default is the point rather than
# caution for its own sake. A live call is the only thing this bot does that
# holds a socket open for minutes, spends an allowance as a stream rather than
# per request, and joins a channel other people are in. A deployment that has
# not opted in must not be able to reach any of that, so the gate is read on the
# path itself and is not a promise in a comment.
#
# Turning it on is not sufficient on its own: the real transport also needs an
# MTProto credential (see the bottom of this block). With the flag on and no
# credential, the feature reports that it cannot carry a call rather than
# pretending to.
GEMINI_LIVE_ENABLED=false

# The model preference order, measured rather than assumed. On real Persian
# speech synthesised by this project's own TTS, the time from end of utterance
# to the first audio byte was:
#
#   gemini-3.8-live                 1.12 s   (fa-IR)
#   gemini-3.1-flash-live-preview   1.12 s   (fa-IR)
#   gemini-2.5-flash-native-audio   2.21 s   (auto-detect only)
#
# The purpose-built native-audio model is the obvious choice and it is the wrong
# one: it is twice as slow here and it refuses every explicit Persian language
# code, so it can only be used on auto-detect. The general live model is first
# for that reason, and the flash preview is the fallback because it measured
# identically.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODELS=gemini-3.1-flash-live-preview

# Its own credential, with the shared pool as an opt-in — the same shape every
# other workload has. A live call is the most expensive thing here by the
# minute, so the default is isolation: an operator who wants calls to draw on
# the shared keys has to say so.
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_ALLOW_SHARED_KEY=false

# Per account, like chat's and awareness's, and its own number for the same
# reason those two are separate from each other: a live call must not be able to
# spend the allowance somebody is waiting on a text answer for. The unit is
# *connections*, not minutes — the pool rations requests, and one call is one
# request — so this is a cap on how many calls one credential will start in an
# API day, not on how long they last. Session length is bounded separately, by
# GEMINI_LIVE_MAX_SECONDS below.
GEMINI_LIVE_DAILY_LIMIT=60

# How long the provider is given to accept a connection. A live session is
# opened once per call, so this is a connect timeout and not a per-turn one —
# there is no per-turn deadline to set, because the turn is a stream.
GEMINI_LIVE_TIMEOUT_SECONDS=30.0

# Persian, first-class. The native-audio family rejects «fa-IR» and accepts only
# auto-detect; the general live models accept it, which is the second reason
# they are preferred. Kept configurable because a deployment serving a different
# language should not have to edit code.
GEMINI_LIVE_LANGUAGE=fa-IR

# The voice the model speaks in. A prebuilt name; an unknown one is refused by
# the provider at setup, which surfaces as setup_rejected rather than as silence.
GEMINI_LIVE_VOICE=Puck

# ---- Ceilings ----------------------------------------------------------------
# A live call is the one workload that can hold a resource for an unbounded
# time, so every dimension of that is bounded here rather than left to the
# operator to notice.

# Concurrent calls. One is the honest default for a single-group deployment: two
# simultaneous calls would mean two provider sessions, two voice channels and
# two allowances spent, and nothing in the feature needs it.
GEMINI_LIVE_MAX_SESSIONS=1

# How long one call may last before it is ended. Not a technical limit — a
# policy one: a session left open holds a provider connection and a voice
# channel, and the failure mode of "it was never closed" is expensive and
# silent. An hour is far longer than a conversation and far shorter than a leak.
GEMINI_LIVE_MAX_SECONDS=3600

# How long a call with nobody speaking is kept open. The room being empty and
# the room being quiet are the same thing from here, and both mean nobody is
# waiting for an answer.
GEMINI_LIVE_IDLE_SECONDS=180

# ---- Reconnect ---------------------------------------------------------------
# A dropped provider session is retried, with backoff, up to this many times.
# The call stays joined to Telegram across the retries: leaving and rejoining a
# voice chat every time a socket hiccups would be far more disruptive than the
# hiccup. The retry resumes the provider session rather than starting a fresh
# one, so the conversation survives the drop.
GEMINI_LIVE_RECONNECT_ATTEMPTS=3
GEMINI_LIVE_RECONNECT_BACKOFF_SECONDS=1.5

# ---- Barge-in ----------------------------------------------------------------
# Whether speech over the top of Nexus stops it. On by default because a
# conversation where you cannot interrupt is not a conversation — but it is a
# switch, because the provider's own detector is what decides, and a deployment
# where it misbehaves needs a way to turn the *reaction* off without turning the
# feature off.
GEMINI_LIVE_BARGE_IN=true

# ---- Awareness ---------------------------------------------------------------
# How long a context snapshot is reused before it is rebuilt. This is the number
# that makes "refreshable during a call" affordable: a snapshot is assembled
# from the room's own records, and rebuilding it on every utterance would run a
# query per sentence. The *conversation* is continuous regardless — only the
# server-side context is cached. Context is scoped to the group the call is in
# and never crosses into another group.
GEMINI_LIVE_CONTEXT_TTL_SECONDS=45.0

# The ceiling on the context block handed to a live session. Deliberately the
# same shape as the awareness ceiling and a separate number, because a live
# session re-sends its context as part of the session rather than per request,
# and the two budgets should not move together by accident.
GEMINI_LIVE_CONTEXT_CHARS=1500

# ---- Spoken actions ----------------------------------------------------------
# The model may *ask* for an administrative action; it may never perform one.
# What it produces is a structured request that goes through the same
# authorisation and the same audit trail as every other action in this bot, and
# it is refused unless the speaker is authorised for it. Two limits, because a
# spoken action is the one thing here with a side effect in a chat other people
# are watching: the cooldown stops a model that has misheard from repeating the
# same request in a loop, and the per-session ceiling stops a long call from
# becoming an unbounded run of them.
GEMINI_LIVE_ACTION_COOLDOWN_SECONDS=3.0
GEMINI_LIVE_MAX_ACTIONS=20

# ---- The deterministic commands ----------------------------------------------
# Bringing Nexus into a voice chat and taking it out are *commands*, not requests
# to a model: they must work with no model, no network and no allowance, for the
# same reason the spoken on/off switch does. So they are matched as phrases,
# before any conversational path is reached, and they are owner-only. They are
# deliberately phrases rather than a /command: the point is to be able to say
# them out loud, which is what this whole feature is for.
#
# A phrase that names voice live is recognised as being about this layer and not
# about the assistant's own on/off switch, for the same reason NEXUS_AWARENESS_NAMES
# exists: the two share a vocabulary and the router has to know which layer was
# named. A message the assistant's own switch vocabulary claims is left to it.
GEMINI_LIVE_JOIN_PHRASES=نکسوس برو ویس‌کال,نکسوس برو ویس چت,نکسوس بیا تو ویس,برو ویس‌کال
GEMINI_LIVE_LEAVE_PHRASES=نکسوس بیا بیرون,نکسوس بیا بیرون از ویس,از ویس‌کال بیا بیرون,بیا بیرون از ویس
GEMINI_LIVE_NAMES=ویس‌کال,ویس چت,ویس,voice live,voice

# What the owner is told when one of those commands is used. Every outcome gets
# its own sentence, because the four failures need four different fixes and a
# single "could not" would send the operator looking in the wrong place: the
# feature being switched off is a decision, a missing transport is a
# configuration, a busy group is a state, and a refused join is Telegram. None
# of them names a credential, a model or an id.
GEMINI_LIVE_JOINED_TEXT=نکسوس آمد داخل ویس‌کال و گوش می‌دهد.
GEMINI_LIVE_LEFT_TEXT=نکسوس از ویس‌کال بیرون آمد.
GEMINI_LIVE_NOT_IN_CALL_TEXT=نکسوس الان داخل ویس‌کال نیست.
GEMINI_LIVE_OFF_TEXT=قابلیت ویس‌کال روی این نصب خاموش است.
GEMINI_LIVE_UNAVAILABLE_TEXT=الان نمی‌توانم داخل ویس‌کال بیایم؛ ورودی ویس‌کال روی این نصب آماده نیست.
GEMINI_LIVE_BUSY_TEXT=الان یک تماس صوتی در این گروه باز است.
GEMINI_LIVE_FAILED_TEXT=نتوانستم داخل ویس‌کال بیایم.

# The feature is on, but the assistant itself is switched off. A call *is* the
# assistant, so a call cannot start while the assistant has been told to stop —
# and the sentence says which of the two switches is in the way, because the
# owner's next action is different for each.
GEMINI_LIVE_NEXUS_OFF_TEXT=نکسوس خاموش است؛ اول روشنش کن.

# ---- The transport -----------------------------------------------------------
# Which implementation carries the call. auto uses the real one when it is
# usable and reports not_configured when it is not, which is the honest answer
# on a build or an account that cannot hold a call yet.
#
# The missing piece is a **credential**, not a library: ntgcalls 2.2.5 publishes
# cp312-manylinux_2_28_x86_64 wheels, so py-tgcalls installs on this
# deployment's interpreter. What is absent is the api_id/api_hash pair and the
# logged-in MTProto session that joining a voice chat requires. An earlier
# version of this comment said no wheel existed, which was wrong.
#
# fake is for tests and for a deployment that wants the subsystem's plumbing
# exercised without a voice channel. It is not a way to run this in production:
# a fake transport joins nothing, and the session refuses to hold a production
# call on one rather than pretending.
GEMINI_LIVE_TRANSPORT=auto

# The MTProto credentials the real transport needs. A *user* session, not the
# bot token: the Bot API has no method to join a voice chat at all, so this
# feature cannot be built on the bot's own credentials and must not pretend to
# be. Both are empty by default and the transport reports credentials_missing
# until both are set. api_id and api_hash come from my.telegram.org.
#
# The session file itself is not an environment variable you set: it is created
# once, interactively, by
#     docker compose run --rm guardbot python -m tools.voice_live_session
# and then reused. See AgentMD §51.17. It is a credential — never commit it,
# never paste it anywhere.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the MTProto session is stored. Inside the data volume, like the key
# store, so it survives a container rebuild — and deliberately a separate file,
# because it is a login and not a setting.
GEMINI_LIVE_SESSION_PATH=/data/voice_live.session

# ---- Web search --------------------------------------------------------------
# Nexus checks the live web for informational questions by default, using a
# search provider — Google Search grounding by default, Tavily selectable (see
# SEARCH_PROVIDER below). It is a *separate workload* — its own
# credential, model, timeout, breaker and daily allowance — and not a mode of the
# conversation. The reason is accounting: grounding runs inside a Gemini request,
# so switching it on for the chat call would make every factual question spend
# the allowance a reply is waiting on. Instead the search call is made on this
# workload, and its findings cross back as bounded, delimited untrusted data.
#
# The switch defaults on, because the point is that Nexus checks the web by
# default rather than only when told to. What makes that safe is the credential:
# with GEMINI_SEARCH_API_KEY empty (and no opt-in to the shared pool) the
# workload has no account, reports itself inert at boot, and the assistant
# answers exactly as it did before this feature existed. Same fail-closed shape
# as awareness.
GEMINI_SEARCH_ENABLED=true

# Its own credential. The shared pool is opt-in and off by default, for the same
# reason the other workloads' are: Google's limits are per project, and grounding
# has a quota of its own, so sharing is a decision rather than a convenience.
# Leave this empty and search is inert — nothing else changes.
GEMINI_SEARCH_API_KEY=
GEMINI_SEARCH_ALLOW_SHARED_KEY=false

# Which provider answers a search. The workload above is provider-agnostic: the
# policy, the brakes, the untrusted frame and the source attribution are the same
# whichever provider answers, and only the transport and the response shape
# change. Exactly one is active:
#   gemini  the original — Google Search grounding, on GEMINI_SEARCH_API_KEY
#   tavily  the Tavily search API, on TAVILY_API_KEY
# There is deliberately no automatic fallback between them: a fallback would
# spend two requests on one question and would let a failure on one provider draw
# on the other's allowance. An unknown value falls back to gemini and says so
# once, so a typo can never silence the assistant.
SEARCH_PROVIDER=gemini

# Tavily's own credential, separate from every Gemini workload and never eligible
# for the shared pool. Empty means Tavily search is inert and the assistant is
# unchanged. The key is sent only in the Authorization header — never in the
# request body, the URL, a log line or a status.
TAVILY_API_KEY=

# Its own model preference. Defaults to the conversation's family because the job
# has the same shape; every model in the default list supports Google Search
# grounding.
GEMINI_SEARCH_MODEL=gemini-flash-lite-latest
# GEMINI_SEARCH_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite

# Its own bounds. The deadline is tighter than the conversation's because nobody
# is waiting on the search itself — they are waiting on the answer — and a search
# that runs long has to give the answer its turn. On failure the reply is written
# without web findings and says so.
GEMINI_SEARCH_TIMEOUT_SECONDS=15
GEMINI_SEARCH_MAX_RETRIES=1
GEMINI_SEARCH_BACKOFF_SECONDS=1.5
GEMINI_SEARCH_CIRCUIT_FAILURES=5
GEMINI_SEARCH_CIRCUIT_SECONDS=300
GEMINI_SEARCH_RATE_LIMIT=8
GEMINI_SEARCH_RATE_WINDOW=60

# Per account per API day, like the conversation's and awareness's, and its own
# number: a factual question must not be able to spend the allowance a reply is
# waiting on, nor the other way round.
GEMINI_SEARCH_DAILY_LIMIT=150

# What is kept: how many sources are surfaced, how long the findings block that
# enters the prompt may be, how much of the question is sent, and how much recent
# conversation (currently unused by the caller, which sends only the question —
# the room window is other people's private conversation).
GEMINI_SEARCH_MAX_RESULTS=5
GEMINI_SEARCH_MAX_CHARS=1800
GEMINI_SEARCH_QUERY_CHARS=600
GEMINI_SEARCH_MAX_HISTORY_CHARS=600

# The note the model is given when a search was attempted and did not land, so it
# says it could not check rather than inventing a live fact. English because it
# is an instruction to the model; the model says the honest thing to the person.
GEMINI_SEARCH_UNAVAILABLE_NOTE=A live web search was attempted for this question and returned no usable results. Do not claim to have current or live information. If the question depends on current information, say plainly that you could not check the web just now.

# What the person sees under a grounded reply. The application writes this from
# the grounding metadata, never the model, which is what keeps the reply itself
# link-free while the sources are still visible.
GEMINI_SEARCH_SOURCES_TITLE=🌐 منابع:
