# ---- required ----
BOT_TOKEN=123456:ABC-your-token-from-botfather
GROUP_IDS=-1001234567890
# private admin group where reports are sent (optional but recommended)
ADMIN_LOG_CHAT=-1009876543210

# ---- optional ----
# extra user ids that are always immune (comma separated)
WHITELIST_USER_IDS=

# captcha
CAPTCHA_ENABLED=true
CAPTCHA_TIMEOUT_SEC=120

# ---- explicit media moderation ----
MEDIA_ENABLED=true

# Body-region classes that count as explicit evidence (NudeNet class names).
# Anything not listed here can never trigger a deletion.
EXPLICIT_CLASSES=FEMALE_GENITALIA_EXPOSED,MALE_GENITALIA_EXPOSED,ANUS_EXPOSED

# >= this confidence for an explicit class -> EXPLICIT (delete the message).
# NudeNet 320n is not a calibrated probability model: its own detection gate is
# 0.20 and its NMS threshold is 0.25. Confirmed explicit media from live testing
# scored 0.50-0.67, so 0.45 sits just below the lowest confirmed true positive
# while staying well above the model's noise floor.
EXPLICIT_DELETE_THRESHOLD=0.45

# >= this (but below the delete threshold) -> REVIEW: logged only.
# No deletion and no admin notification for REVIEW.
EXPLICIT_REVIEW_THRESHOLD=0.25

# ---- second-stage scene classifier (local, CPU) ----
# NudeNet only sees explicit body regions; it cannot see a sexual act when no
# genitalia are visible. This stage adds a scene-level NSFW score on top of it
# so the overall sexual nature of the media is recognised.
#
# It is graded:
#   score <  SCENE_REVIEW_THRESHOLD  -> SAFE
#   score >= SCENE_REVIEW_THRESHOLD  -> REVIEW   (logged only, never deletes)
#   score >= SCENE_DELETE_THRESHOLD  -> EXPLICIT (deletes the message)
# It fails open: a missing model/dependency or an inference error leaves the
# score absent, and an absent score never deletes.
#
# Measured cost on this 2-core VPS: ~1.7 s per scored frame (the model is
# loaded once at startup). Set SCENE_ENABLED=false to skip the stage entirely.
SCENE_ENABLED=true
SCENE_MODEL=Falconsai/nsfw_image_detection

# A scene score at or above this deletes, even with no NudeNet evidence.
# Deliberately high - this threshold deletes media. Tune it against real
# traffic, do not lower it just to "catch more".
SCENE_DELETE_THRESHOLD=0.95
# Lower bound of the REVIEW band (mildly suggestive / ambiguous).
SCENE_REVIEW_THRESHOLD=0.60
# How many of the already-sampled frames the scene stage scores (bounded cost;
# 1 = old single-frame behaviour). Raising it costs ~1.7 s per extra frame.
SCENE_MAX_FRAMES=2

# video / GIF / animated sticker: number of frames sampled
VIDEO_FRAMES=4
MEDIA_WORKERS=2
# files larger than this (Bot API limit) are only checked via their thumbnail
MAX_DOWNLOAD_MB=20

# ---- instant media flood (burst) ----
# More than BURST_MAX_ITEMS qualifying media messages from the same user inside
# BURST_WINDOW_SECONDS is a flood. The window is deliberately very short: this
# stops an instant flood, it is not a "sent a lot of media today" rule.
BURST_ENABLED=true
BURST_WINDOW_SECONDS=3
BURST_MAX_ITEMS=5
# Which media kinds count. Ordinary photos are never counted, so sending
# several photos quickly is not a flood.
#   gif, sticker, animated_sticker, video_sticker, video_note
BURST_MEDIA_KINDS=gif,sticker,animated_sticker,video_sticker,video_note

# ---- repeated violations ----
# One confirmed explicit-media deletion = one violation. A warning is sent each
# time; the timed restriction is applied when the count reaches this number.
VIOLATION_MUTE_AFTER=3
# Restriction length in minutes (0 = no automatic expiry). Telegram lifts a
# timed restriction itself, so no reaper is needed.
# NOTE: this used to be MUTE_HOURS (default 24). A leftover MUTE_HOURS in an
# existing .env is no longer read.
MUTE_MINUTES=15

# ---- test account ----
# One user id used to exercise the moderation pipeline repeatedly in a test
# group. It is NOT exempt from anything: detection, deletion, strikes, the admin
# report and the real Telegram restrict call all run normally. The only
# difference is that a successful restriction is lifted again after
# TEST_USER_UNRESTRICT_SECONDS, and the warning from that cycle is deleted, so
# the next test violation can be sent straight away. Set TEST_USER_ID=0 to
# disable the exception entirely.
TEST_USER_ID=8299811287
TEST_USER_UNRESTRICT_SECONDS=2

