# ---- required ----
BOT_TOKEN=123456:ABC-your-token-from-botfather
GROUP_IDS=-1001234567890
# private admin group where reports are sent (optional but recommended)
ADMIN_LOG_CHAT=-1009876543210

# ---- optional ----
# extra user ids that are always immune (comma separated)
WHITELIST_USER_IDS=

# captcha
CAPTCHA_ENABLED=true
CAPTCHA_TIMEOUT_SEC=120

# media moderation
MEDIA_ENABLED=true
NSFW_DELETE_THRESHOLD=0.60
NSFW_BAN_THRESHOLD=0.90
HIGH_CONF_ACTION=ban          # ban | mute
MUTE_HOURS=24
VIDEO_FRAMES=4
MEDIA_WORKERS=2
MAX_STRIKES=2

# trust: after N messages, thresholds get +TRUSTED_EXTRA_MARGIN
TRUST_AFTER_MESSAGES=30
TRUSTED_EXTRA_MARGIN=0.10
